# Copie para .env.local (dev) e configure as mesmas chaves em
# Vercel → Project Settings → Environment Variables (produção).

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
SUPABASE_DB_URL=postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# String aleatória longa (ex: gere com `openssl rand -base64 48`) — assina o cookie de login
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Origem liberada por CORS quando não há cabeçalho Origin (uso raro; same-origin não precisa disso)
CORS_ORIGIN=*
